{
  "name": "event-post",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EventPost — クローズドなグループのためのイベント管理サイト（GitHub Pages + Firebase + Actions）",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "check": "tsc -p web/tsconfig.json && tsc -p tsconfig.json",
    "test": "vitest run",
    "emulators": "firebase emulators:start --config firebase/firebase.json --project demo-event-post --only auth,firestore",
    "test:rules": "firebase emulators:exec --config firebase/firebase.json --project demo-event-post --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "notify": "tsx scripts/notify.ts",
    "cleanup:old": "tsx scripts/cleanup-old.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "dompurify": "^3.4.17",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "marked": "^18.1.3",
    "nodemailer": "^10.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.34.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
