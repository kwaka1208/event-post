---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { url } from '@/lib/url';
---

<BaseLayout title="ページが見つかりません" noindex>
  <main class="main">
    <h1>ページが見つかりません</h1>
    <p>URL が間違っているか、イベントが公開を終了した可能性があります。</p>
    <p><a href={url()} class="back">イベント一覧へ</a></p>
  </main>
</BaseLayout>

<style>
  .main {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    padding: 28px 20px 40px;
  }
  h1 {
    margin: 0 0 12px;
    font-family: var(--font-heading);
    font-size: 24px;
  }
  p {
    margin: 0 0 8px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
