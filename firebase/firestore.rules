rules_version = '2';

// Fireside の Firestore セキュリティルール
// Cloud Functions を使わないため、権限の確認と入力の検証はすべてここで行う。
// Actions（Admin SDK）はルールを迂回するので、メール送信の記録などはここでは考えない。
// 文字数の上限は web/src/lib/limits.ts と合わせる。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function groupPath() {
      return /databases/$(database)/documents/group/profile;
    }

    function memberPath(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }

    function applicationPath(uid) {
      return /databases/$(database)/documents/applications/$(uid);
    }

    function eventPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId);
    }

    function registrationPath(eventId, uid) {
      return /databases/$(database)/documents/events/$(eventId)/registrations/$(uid);
    }

    function isMember() {
      return signedIn() && exists(memberPath(request.auth.uid));
    }

    function myRole() {
      return get(memberPath(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isMember() && myRole() in ['owner', 'admin'];
    }

    function isOwner() {
      return isMember() && myRole() == 'owner';
    }

    function text(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function exactKeys(d, keys) {
      return d.keys().hasOnly(keys) && d.keys().hasAll(keys);
    }

    // ------------------------------------------------------------------
    // group/profile：グループの情報。トップページに出すので誰でも読める
    // ------------------------------------------------------------------
    match /group/profile {
      allow read: if true;

      // 最初の 1 回だけ。作成者自身の members（role: owner）と同時に作る
      allow create: if verified()
        && validGroup(request.resource.data)
        && exactKeys(request.resource.data, ['name', 'description', 'ownerName', 'ownerUid', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(memberPath(request.auth.uid)).data.role == 'owner';

      // 特権管理者だけが、名前・説明・表示する管理者名を変えられる
      allow update: if isOwner()
        && validGroup(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'ownerName']);

      // 管理者（特権管理者を含む）が、テーマカラーを変える・消す。コントラストは画面で確かめる
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accentColor'])
        && (!('accentColor' in request.resource.data)
          || (request.resource.data.accentColor is string
            && request.resource.data.accentColor.matches('#[0-9a-f]{6}')));

      allow delete: if false;

      function validGroup(d) {
        return text(d.name, 1, 100)
          && text(d.description, 0, 2000)
          && text(d.ownerName, 1, 100);
      }
    }

    // ------------------------------------------------------------------
    // members/{uid}：グループのメンバー（ドキュメント ID は uid）
    // ------------------------------------------------------------------
    match /members/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();

      allow create: if isCreatingOwner(uid) || isApproving(uid);

      allow update: if isChangingRole() || isEditingOwnProfile(uid) || isEditingTags();

      // 管理者が、メンバーのタグ（グループの中での分類）を付け直す。1 人 10 個まで。
      // タグ 1 つの文字数（20 文字まで）は、ルールでは確かめられないので画面で確かめる
      function isEditingTags() {
        return isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tags'])
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 10;
      }

      // 役割を変えられるのは特権管理者だけ。特権管理者自身の役割は変えられない
      function isChangingRole() {
        return isOwner()
          && resource.data.role != 'owner'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['admin', 'member'];
      }

      // 本人が、マイページで自分の本名とニックネームを変える。役割やメールアドレスは変えられない
      function isEditingOwnProfile(uid) {
        return signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['realName', 'nickname'])
          && text(request.resource.data.realName, 1, 100)
          && text(request.resource.data.nickname, 1, 100);
      }

      // 参加者は管理者が、管理者は特権管理者が削除できる。本人はマイページから退会できる。
      // 特権管理者は削除も退会もできない
      allow delete: if resource.data.role != 'owner'
        && (isOwner()
          || (isAdmin() && resource.data.role == 'member')
          || (signedIn() && request.auth.uid == uid));

      function memberKeys() {
        return ['uid', 'role', 'realName', 'nickname', 'email', 'joinedAt'];
      }

      // グループの作成：group/profile がまだなく、この書き込みで自分を owner にして作る
      function isCreatingOwner(uid) {
        let d = request.resource.data;
        return verified()
          && request.auth.uid == uid
          && !exists(groupPath())
          && getAfter(groupPath()).data.ownerUid == uid
          && exactKeys(d, memberKeys())
          && d.uid == uid
          && d.role == 'owner'
          && text(d.realName, 1, 100)
          && text(d.nickname, 1, 100)
          && d.email == request.auth.token.email
          && d.joinedAt == request.time;
      }

      // 承認：申し込みの内容を写して members を作り、同じ書き込みで申し込みを消す。
      // 管理者として承認できるのは特権管理者だけ
      function isApproving(uid) {
        let d = request.resource.data;
        let app = get(applicationPath(uid)).data;
        return isAdmin()
          && exists(applicationPath(uid))
          && !existsAfter(applicationPath(uid))
          && exactKeys(d, memberKeys())
          && d.uid == uid
          && (d.role == 'member' || (d.role == 'admin' && isOwner()))
          && d.realName == app.realName
          && d.nickname == app.nickname
          && d.email == app.email
          && d.joinedAt == request.time;
      }
    }

    // ------------------------------------------------------------------
    // directory/{uid}：メンバー一覧に出す内容（ドキュメント ID は uid）。
    // members は本人と管理者しか読めないので、メンバー全員に見せるもの（ニックネームの写し、
    // 自己紹介、URL）だけをここに置く。ニックネームは、書いた後の members と同じでなければならない
    // ------------------------------------------------------------------
    match /directory/{uid} {
      allow read: if isMember();

      // 本人が自己紹介と URL を書く。グループの作成、名前の変更と同時にも書く
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && existsAfter(memberPath(uid))
        && validDirectoryEntry(uid, request.resource.data);

      // 管理者が、空の自己紹介で足す（承認と同時、またはこの機能より前からいるメンバーの分）
      allow create: if isAdmin()
        && existsAfter(memberPath(uid))
        && validDirectoryEntry(uid, request.resource.data)
        && request.resource.data.bio == ''
        && request.resource.data.url == ''
        && !('photo' in request.resource.data);

      // 消せるのは、メンバーでなくなったとき（退会・削除と同時、または後から）だけ
      allow delete: if ((signedIn() && request.auth.uid == uid) || isAdmin())
        && !existsAfter(memberPath(uid));

      // URL は空か、http:// か https:// で始まって空白を含まないもの。
      // 画像（photo）はなくてもよい。あるときは JPEG・PNG・WebP の data: URL で、10 万字まで
      function validDirectoryEntry(uid, d) {
        return d.keys().hasOnly(['uid', 'nickname', 'bio', 'url', 'photo'])
          && d.keys().hasAll(['uid', 'nickname', 'bio', 'url'])
          && (!('photo' in d) || (text(d.photo, 1, 100000)
            && d.photo.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+')))
          && d.uid == uid
          && d.nickname == getAfter(memberPath(uid)).data.nickname
          && text(d.bio, 0, 100)
          && text(d.url, 0, 500)
          && (d.url == '' || d.url.matches('https?://[^\\s]+'));
      }
    }

    // ------------------------------------------------------------------
    // applications/{uid}：参加申し込み（ドキュメント ID は申込者の uid）
    // ------------------------------------------------------------------
    match /applications/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();

      // グループがあり、まだメンバーでない本人だけが申し込める
      allow create: if verified()
        && request.auth.uid == uid
        && exists(groupPath())
        && !isMember()
        && validApplication(uid, request.resource.data);

      // 内容を変えたいときは取り下げて申し込み直す
      allow update: if false;

      // 本人の取り下げと、管理者の削除（承認時の削除も含む）
      allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();

      function validApplication(uid, d) {
        return exactKeys(d, ['uid', 'realName', 'nickname', 'reason', 'email', 'createdAt'])
          && d.uid == uid
          && text(d.realName, 1, 100)
          && text(d.nickname, 1, 100)
          && text(d.reason, 1, 1000)
          && d.email == request.auth.token.email
          && d.createdAt == request.time;
      }
    }

    // ------------------------------------------------------------------
    // mails/{id}：管理者が書いたメール。毎時の Actions（Admin SDK）が宛先に 1 人ずつ送り、
    // 送信状況（status、deliveredUids など）を書く。宛先は書いた時点の名前とメールアドレスの写し
    // ------------------------------------------------------------------
    match /mails/{mailId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && exactKeys(request.resource.data,
          ['subject', 'body', 'recipients', 'createdByUid', 'createdByName', 'createdAt', 'status'])
        && text(request.resource.data.subject, 1, 200)
        && text(request.resource.data.body, 1, 10000)
        && request.resource.data.recipients is list
        && request.resource.data.recipients.size() >= 1
        && request.resource.data.recipients.size() <= 500
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByName == get(memberPath(request.auth.uid)).data.realName
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'pending';

      // 内容は変えられない。直したいときは、送信前に削除して書き直す
      allow update: if false;

      // 送信前（status が pending で、まだ誰にも届けていない）だけ削除できる
      allow delete: if isAdmin()
        && resource.data.status == 'pending'
        && !('deliveredUids' in resource.data && resource.data.deliveredUids.size() > 0);
    }

    // ------------------------------------------------------------------
    // inquiries/{id}：メンバーから管理者への問い合わせ。毎時の Actions（Admin SDK）が管理者全員に送り、
    // 通知した日時（notifiedAt）を書く。送った人の名前とメールアドレスは、送った時点の members の写し
    // ------------------------------------------------------------------
    match /inquiries/{inquiryId} {
      allow read: if isAdmin();

      allow create: if isMember() && validInquiry(request.resource.data);

      // 内容は変えられない
      allow update: if false;

      // 管理者が、対応を終えたものなどを削除する
      allow delete: if isAdmin();

      function validInquiry(d) {
        let me = get(memberPath(request.auth.uid)).data;
        return exactKeys(d, ['uid', 'realName', 'nickname', 'email', 'subject', 'body', 'createdAt'])
          && d.uid == request.auth.uid
          && d.realName == me.realName
          && d.nickname == me.nickname
          && d.email == me.email
          && text(d.subject, 1, 200)
          && text(d.body, 1, 5000)
          && d.createdAt == request.time;
      }
    }

    // ------------------------------------------------------------------
    // topics/{topicId}：掲示板の話題。メンバーが立て、メンバー全員が読める。
    // 書いた人のニックネームは、書いた時点の members の写し（あとで名前を変えても、投稿は当時のまま）
    // ------------------------------------------------------------------
    match /topics/{topicId} {
      allow read: if isMember();

      // 最後の投稿日時（lastPostedAt）は作成日時から始める。lastReplyId は返信がつくまで null
      allow create: if isMember()
        && exactKeys(request.resource.data,
          ['uid', 'nickname', 'title', 'body', 'createdAt', 'lastPostedAt', 'lastReplyId'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname == get(memberPath(request.auth.uid)).data.nickname
        && text(request.resource.data.title, 1, 100)
        && text(request.resource.data.body, 1, 5000)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastPostedAt == request.time
        && request.resource.data.lastReplyId == null;

      // 返信がついたときに、最後の投稿日時を進める（一覧を新しい順に並べるため）。
      // 同じ書き込みで、lastReplyId の返信を新しく作るときだけ。内容は変えられない
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastPostedAt', 'lastReplyId'])
        && request.resource.data.lastPostedAt == request.time
        && request.resource.data.lastReplyId is string
        && !exists(replyPath(topicId, request.resource.data.lastReplyId))
        && existsAfter(replyPath(topicId, request.resource.data.lastReplyId));

      // 立てた人と管理者。返信は、画面が先に 1 件ずつ消してから話題を消す
      allow delete: if isMember() && (resource.data.uid == request.auth.uid || isAdmin());

      function replyPath(topicId, replyId) {
        return /databases/$(database)/documents/topics/$(topicId)/replies/$(replyId);
      }

      // ----------------------------------------------------------------
      // topics/{topicId}/replies/{replyId}：話題への返信
      // ----------------------------------------------------------------
      match /replies/{replyId} {
        allow read: if isMember();

        // 話題の lastPostedAt と lastReplyId を同じ書き込みで進める
        allow create: if isMember()
          && exists(/databases/$(database)/documents/topics/$(topicId))
          && exactKeys(request.resource.data, ['uid', 'nickname', 'body', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.nickname == get(memberPath(request.auth.uid)).data.nickname
          && text(request.resource.data.body, 1, 5000)
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/topics/$(topicId)).data.lastReplyId == replyId;

        // 内容は変えられない。直したいときは、消して書き直す
        allow update: if false;

        // 書いた人、管理者、話題を立てた人（話題を消すとき）
        allow delete: if isMember()
          && (resource.data.uid == request.auth.uid
            || isAdmin()
            || get(/databases/$(database)/documents/topics/$(topicId)).data.uid == request.auth.uid);
      }
    }

    // ------------------------------------------------------------------
    // events/{eventId}：イベント。公開中はメンバーが、下書きは管理者だけが読める
    // ------------------------------------------------------------------
    match /events/{eventId} {
      // メンバーが一覧を読むときは where('published', '==', true) で絞り込む（ルールが通るように）
      allow read: if isAdmin() || (isMember() && resource.data.published == true);

      // 申込数（registrationCount）は 0 から始める
      allow create: if isAdmin()
        && exactKeys(request.resource.data, eventKeys())
        && validEvent(request.resource.data)
        && request.resource.data.registrationCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // 管理者の編集か、申込・キャンセルに合わせた申込数の ±1
      allow update: if isEditingEvent() || isCountingRegistration(eventId);

      // 申込がないイベントだけ削除できる。申込があるときは下書きに戻す
      allow delete: if isAdmin() && resource.data.registrationCount == 0;

      // 管理者の編集。申込数と作成日時は変えられない。定員は今の申込数より少なくできない。
      // Actions（Admin SDK）がメールの送信日時などを書き足しても編集できるよう、変える項目だけを確かめる
      function isEditingEvent() {
        return isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(editableEventKeys())
          && validEvent(request.resource.data)
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.capacity == null
            || request.resource.data.capacity >= resource.data.registrationCount);
      }

      // 申込数だけを ±1 する。同じ書き込みで、自分の申込を作る（+1）か消す（-1）ときだけ。
      // 公開中か、締切、定員、キャンセルの期限は registrations のルールで確かめる
      function isCountingRegistration(eventId) {
        let before = resource.data.registrationCount;
        let after = request.resource.data.registrationCount;
        let reg = registrationPath(eventId, request.auth.uid);
        return signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registrationCount'])
          && ((after == before + 1 && !exists(reg) && existsAfter(reg))
            || (after == before - 1 && exists(reg) && !existsAfter(reg)));
      }

      function eventKeys() {
        return ['title', 'body', 'startAt', 'endAt', 'deadlineAt', 'venue', 'address', 'capacity',
          'published', 'registrationCount', 'createdAt', 'updatedAt'];
      }

      function editableEventKeys() {
        return ['title', 'body', 'startAt', 'endAt', 'deadlineAt', 'venue', 'address', 'capacity',
          'published', 'updatedAt'];
      }

      // 締切は開始日時まで。定員は null（定員なし）か 1〜10000
      function validEvent(d) {
        return text(d.title, 1, 100)
          && text(d.body, 0, 10000)
          && d.startAt is timestamp
          && d.endAt is timestamp
          && d.deadlineAt is timestamp
          && d.endAt > d.startAt
          && d.deadlineAt <= d.startAt
          && text(d.venue, 1, 100)
          && text(d.address, 0, 200)
          && (d.capacity == null || (d.capacity is int && d.capacity >= 1 && d.capacity <= 10000))
          && d.published is bool;
      }

      // ----------------------------------------------------------------
      // events/{eventId}/registrations/{uid}：イベントへの申込（ドキュメント ID は申込者の uid）
      // ----------------------------------------------------------------
      match /registrations/{uid} {
        // 本人と管理者。管理者は申込者の一覧を読む
        allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();

        // メンバー本人が、公開中で締切前のイベントに申し込む。申込数の +1 と同時に書き、定員を超えない
        allow create: if signedIn()
          && request.auth.uid == uid
          && isMember()
          && validRegistration(uid, request.resource.data)
          && get(eventPath(eventId)).data.published == true
          && request.time < get(eventPath(eventId)).data.deadlineAt
          && getAfter(eventPath(eventId)).data.registrationCount == get(eventPath(eventId)).data.registrationCount + 1
          && (get(eventPath(eventId)).data.capacity == null
            || getAfter(eventPath(eventId)).data.registrationCount <= get(eventPath(eventId)).data.capacity);

        // 本人が名前を変えたとき、開始前のイベントの申込に残っている名前の写しをそろえる。
        // 写せるのは自分の members の（同じ書き込みで変えた後の）名前だけ
        allow update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['realName', 'nickname'])
          && request.time < get(eventPath(eventId)).data.startAt
          && request.resource.data.realName == getAfter(memberPath(uid)).data.realName
          && request.resource.data.nickname == getAfter(memberPath(uid)).data.nickname;

        // 本人のキャンセル。開始日時まで。申込数の -1 と同時に書く
        allow delete: if signedIn()
          && request.auth.uid == uid
          && request.time < get(eventPath(eventId)).data.startAt
          && getAfter(eventPath(eventId)).data.registrationCount == get(eventPath(eventId)).data.registrationCount - 1;

        // 名前とメールアドレスは、自分の members の内容を写す
        function validRegistration(uid, d) {
          let me = get(memberPath(uid)).data;
          return exactKeys(d, ['uid', 'realName', 'nickname', 'email', 'createdAt'])
            && d.uid == uid
            && d.realName == me.realName
            && d.nickname == me.nickname
            && d.email == me.email
            && d.createdAt == request.time;
        }
      }
    }

    // ------------------------------------------------------------------
    // registrations の collectionGroup 検索：マイページで自分の申込を探す。
    // where('uid', '==', 自分の uid) で絞り込んで読む
    // ------------------------------------------------------------------
    match /{path=**}/registrations/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
